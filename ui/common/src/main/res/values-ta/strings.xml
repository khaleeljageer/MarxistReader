<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Contextual "how to use" help (Tamil) -->
    <string name="help_got_it">புரிந்தது</string>
    <string name="help_content_desc">இந்தத் திரையை எவ்வாறு பயன்படுத்துவது</string>

    <!-- Feed -->
    <string name="help_feed_title">முகப்புப் பட்டியலை எவ்வாறு பயன்படுத்துவது</string>
    <string name="help_feed_read_title">கட்டுரையைப் படிக்க</string>
    <string name="help_feed_read_desc">எந்தக் கட்டுரையையும் திறந்து படிக்க அதைத் தட்டவும்.</string>
    <string name="help_feed_save_title">பின்னர் படிக்கச் சேமிக்க</string>
    <string name="help_feed_save_desc">இணையம் இல்லாமல் படிக்க, கட்டுரையில் உள்ள புத்தகக்குறி ஐகானைத் தட்டி சேமிக்கவும்.</string>
    <string name="help_feed_search_title">தேடல்</string>
    <string name="help_feed_search_desc">கட்டுரைகளைத் தேட மேலே உள்ள தேடல் ஐகானைத் தட்டவும்.</string>
    <string name="help_feed_refresh_title">புதிய கட்டுரைகள்</string>
    <string name="help_feed_refresh_desc">புதிய கட்டுரைகளை ஏற்ற மேலே உள்ள புதுப்பிப்பு ஐகானைத் தட்டவும்.</string>

    <!-- Books -->
    <string name="help_books_title">புத்தகங்களை எவ்வாறு பயன்படுத்துவது</string>
    <string name="help_books_open_title">புத்தகத்தைத் திறக்க</string>
    <string name="help_books_open_desc">படிப்பானில் திறக்க ஒரு புத்தகத்தைத் தட்டவும்.</string>
    <string name="help_books_download_title">இணையம் இல்லாமல் படிக்கப் பதிவிறக்கம்</string>
    <string name="help_books_download_desc">புத்தகத்தை உங்கள் சாதனத்தில் வைத்திருக்க பதிவிறக்க ஐகானைத் தட்டவும்.</string>
    <string name="help_books_offline_title">எப்போது வேண்டுமானாலும் படிக்க</string>
    <string name="help_books_offline_desc">பதிவிறக்கிய புத்தகங்கள் இணைய இணைப்பு இல்லாமலும் திறக்கும்.</string>

    <!-- Search -->
    <string name="help_search_title">எவ்வாறு தேடுவது</string>
    <string name="help_search_type_title">தட்டச்சு செய்து தேடுங்கள்</string>
    <string name="help_search_type_desc">பொருந்தும் கட்டுரைகளைக் காண ஒரு சொல்லை உள்ளிடவும்.</string>
    <string name="help_search_recent_title">சமீபத்திய தேடல்கள்</string>
    <string name="help_search_recent_desc">உங்கள் சமீபத்திய தேடல்கள் கீழே தோன்றும்; மீண்டும் தேட ஒன்றைத் தட்டவும்.</string>
    <string name="help_search_open_title">முடிவைத் திறக்க</string>
    <string name="help_search_open_desc">முழுக் கட்டுரையைப் படிக்க ஒரு முடிவைத் தட்டவும்.</string>

    <!-- Saved -->
    <string name="help_saved_title">சேமித்தவற்றை எவ்வாறு பயன்படுத்துவது</string>
    <string name="help_saved_what_title">நீங்கள் சேமித்த கட்டுரைகள்</string>
    <string name="help_saved_what_desc">நீங்கள் புத்தகக்குறியிட்ட கட்டுரைகள் இங்கே தோன்றும்.</string>
    <string name="help_saved_offline_title">இணையம் இல்லாமல் படிக்க</string>
    <string name="help_saved_offline_desc">சேமித்த கட்டுரைகள் இணையம் இல்லாமலும் கிடைக்கும்.</string>
    <string name="help_saved_remove_title">கட்டுரையை நீக்க</string>
    <string name="help_saved_remove_desc">கட்டுரையைத் திறந்து, புத்தகக்குறி ஐகானை மீண்டும் தட்டி நீக்கவும்.</string>

    <!-- Settings -->
    <string name="help_settings_title">அமைப்புகளை எவ்வாறு பயன்படுத்துவது</string>
    <string name="help_settings_theme_title">தோற்றம்</string>
    <string name="help_settings_theme_desc">வெளிச்சம் மற்றும் இருள் தோற்றத்திற்கு இடையே மாற்றவும்.</string>
    <string name="help_settings_text_title">எழுத்து அளவு</string>
    <string name="help_settings_text_desc">படிக்கும் எழுத்தை பெரிதாக்கவோ சிறிதாக்கவோ செய்யவும்.</string>
    <string name="help_settings_language_title">மொழி</string>
    <string name="help_settings_language_desc">தமிழ் மற்றும் ஆங்கிலத்திற்கு இடையே மாற்றவும்.</string>
    <string name="help_settings_notify_title">அறிவிப்புகள்</string>
    <string name="help_settings_notify_desc">புதிய கட்டுரை அறிவிப்புகளை இயக்கவோ நிறுத்தவோ செய்யவும்.</string>

    <!-- Article detail -->
    <string name="help_article_title">கட்டுரையை எவ்வாறு படிப்பது</string>
    <string name="help_article_text_title">எழுத்து அளவு</string>
    <string name="help_article_text_desc">கட்டுரையை பெரிதாக்கவோ சிறிதாக்கவோ எழுத்து ஐகானைத் தட்டவும்.</string>
    <string name="help_article_save_title">இந்தக் கட்டுரையைச் சேமிக்க</string>
    <string name="help_article_save_desc">இணையம் இல்லாமல் படிக்க புத்தகக்குறி ஐகானைத் தட்டி சேமிக்கவும்.</string>
    <string name="help_article_share_title">பகிர</string>
    <string name="help_article_share_desc">இந்தக் கட்டுரையை மற்றவர்களுக்கு அனுப்ப பகிர் ஐகானைத் தட்டவும்.</string>
    <string name="help_article_links_title">இணைப்புகளைத் திறக்க</string>
    <string name="help_article_links_desc">கட்டுரையில் அடிக்கோடிட்ட இணைப்புகளைத் திறக்க அவற்றைத் தட்டவும்.</string>
</resources>
